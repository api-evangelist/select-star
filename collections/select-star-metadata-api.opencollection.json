              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get owners for an object\n\n**Required Role:** Viewer or higher"
        },
        {
          "info": {
            "name": "metadata_hide_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/metadata/hide/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Hides a list of objects in bulk\n\n**Required Role:** Data Manager or higher"
        },
        {
          "info": {
            "name": "metadata_show_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/metadata/show/",
