{
  "opencollection": "1.0.0",
  "info": {
    "name": "Select Star bi metadata API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "metadata_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/metadata/:guid/",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a single object metadata\n\n**Required Role:** Viewer or higher"
        },
        {
          "info": {
            "name": "metadata_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/metadata/:guid/",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "View to object metadata.\nSupported object types: Database, Schema, Table, Column, Dashboard,\n  DashboardElement\n\n**Required Role:** Data Manager or higher"
        },
        {
          "info": {
            "name": "metadata_owners_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/metadata/:guid/owners/",
