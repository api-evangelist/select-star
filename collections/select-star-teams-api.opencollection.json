{
  "opencollection": "1.0.0",
  "info": {
    "name": "Select Star Metadata bi teams API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "teams_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/teams/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all teams within the organization along with sample users (access: all users)\n\n**Required Role:** Viewer or higher"
        },
        {
          "info": {
            "name": "teams_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/teams/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a team within the organization (access: admin only)\n\n**Required Role:** Admin"
        },
        {
          "info": {
            "name": "teams_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/teams/:guid/",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a team given a guid (access: all users)\n\n**Required Role:** Viewer or higher"
        },
        {
          "info": {
            "name": "teams_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/teams/:guid/",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update the team within the organization (access: admin only)\n\n**Required Role:** Admin"
        },
        {
          "info": {
            "name": "teams_destroy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/teams/:guid/",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove a team from the organization (access: admin only)\n\n**Required Role:** Admin"
        },
        {
          "info": {
            "name": "teams_transfer_users_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/teams/:guid/transfer-users/",
            "params": [
              {
                "name": "guid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Manage Organization Teams\n\n**Required Role:** Admin"
        }
      ]
    }
  ],
  "bundled": true
}